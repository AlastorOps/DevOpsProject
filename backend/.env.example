# Copy this file to backend/.env and fill in your values.
# Never commit backend/.env to version control.
#
# Generate SECRET_KEY with:
#   python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

DATABASE_URL=postgresql://postgres:change-me-strong-password@localhost:5432/emsops
SECRET_KEY=replace-with-generated-key
ADMIN_PASSWORD=replace-with-strong-password
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
UPLOAD_DIR=uploads
