# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key — generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=change-this-to-a-random-base64-string-of-at-least-32-chars

# Initial admin account password (used only on first startup if no admin exists)
ADMIN_PASSWORD=change-me-strong-admin-password

# Docker Hub username (used to tag images)
DOCKER_USERNAME=your-dockerhub-username

# Allowed CORS origins (JSON array). MUST be set to your real domain in production.
CORS_ORIGINS=["https://ems-ops.xyz","https://www.ems-ops.xyz"]

# Swagger UI (/docs). Keep false in production — only enable locally for development.
ENABLE_DOCS=false

# Grafana admin password — required, must be set explicitly.
GRAFANA_PASSWORD=change-me-strong-grafana-password
