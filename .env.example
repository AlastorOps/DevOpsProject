# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# PostgreSQL
POSTGRES_PASSWORD=change-me-strong-password

# JWT signing key — generate with: python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
SECRET_KEY=change-this-to-a-random-base64-string-of-at-least-32-chars

# Initial admin account password
ADMIN_PASSWORD=Admin@123456

# Docker Hub username (used to tag images)
DOCKER_USERNAME=your-dockerhub-username

# Allowed CORS origins (JSON array). Set to your real domain in production.
# CORS_ORIGINS=["https://your-domain.com"]

# Set to true only for development — disables Swagger UI (/docs) in production.
# ENABLE_DOCS=true
